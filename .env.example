# ==============================================================================
# AEGIS-CORE Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit the .env file containing sensitive credentials to version control.

# Application Metadata
PROJECT_NAME="AEGIS-CORE"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Server Settings
HOST="127.0.0.1"
PORT=8000
API_V1_PREFIX="/api/v1"

# Security & CORS
SECRET_KEY="change-this-in-production-use-a-strong-secret-key"
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000"]

# Database Configuration
# SQLite default for development/testing:
DATABASE_URL="sqlite:///./aegis.db"
# Connection pool settings (for SQLite single-file / concurrent safety):
DATABASE_ECHO=false

# Logging Configuration
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"
# Formats: json, console
LOG_FORMAT="console"

# LLM Provider & Mini AI Agent Configuration
# Provider: "fake" (default, deterministic offline mode for tests/demos) or "openai"
LLM_PROVIDER="fake"
# OpenAI API Key (required when LLM_PROVIDER="openai")
# OPENAI_API_KEY="sk-..."
# Optional custom base URL for OpenAI-compatible proxies / local endpoints
# OPENAI_BASE_URL="https://api.openai.com/v1"
# Model identifier (e.g. gpt-4o-mini, gpt-4o)
OPENAI_MODEL="gpt-4o-mini"
# Execution bounds
AGENT_MAX_TOOL_CALLS=5
AGENT_MODEL_TIMEOUT_SECONDS=30.0
AGENT_MAX_OUTPUT_TOKENS=1024

